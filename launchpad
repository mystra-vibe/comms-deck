KITTY_BLOCK = """
# >>> launchpad: lets the agents' notes reach their own window without moving focus
allow_remote_control socket-only
listen_on unix:${XDG_RUNTIME_DIR}/kitty
# <<< launchpad
"""


def claude_hooks(cmd):
    """The hooks block for ~/.claude/settings.json."""
    def entry(event, matcher=None):
        h = {"hooks": [{"type": "command", "command": f"{cmd} hook --source claude --event {event}",
                        "timeout": 10}]}
        if matcher:
            h["matcher"] = matcher
        return h
    return {e: [entry(e)] for e in ("SessionStart", "UserPromptSubmit", "Stop", "SessionEnd")} | {
        "Notification": [entry("Notification", "idle_prompt")]}


def grok_hooks(cmd):
    """The hooks file for ~/.grok/hooks/launchpad.json."""
    return {"hooks": {e: [{"hooks": [{"type": "command", "timeout": 10,
                                      "command": f"{cmd} hook --source grok --event {e}"}]}]
                      for e in ("SessionStart", "UserPromptSubmit", "Stop", "StopCancelled",
                                "Notification", "SessionEnd")}}


def install(yes):
    """Set up: command link, hooks, MCP, kitty, services. Prints each step."""
    here = Path(__file__).resolve().parent
    bin_dir = HOME / ".local/bin"
    cmd = str(bin_dir / "launchpad")
    steps = []

    def step(text, action):
        steps.append((text, action))

    def link(name, target):
        dest = bin_dir / name
        if dest.is_symlink() or not dest.exists():
            dest.unlink(missing_ok=True)
            dest.symlink_to(target)

    step(f"link {bin_dir}/launchpad and push-courier to this repo",
         lambda: (bin_dir.mkdir(parents=True, exist_ok=True), link("launchpad", here / "launchpad"),
                  link("push-courier", here / "push-courier")))

    def claude_settings():
        path = HOME / ".claude/settings.json"
        settings = read_json(path, {}) or {}
        if path.exists():
            shutil.copy(path, path.with_suffix(".json.launchpad-backup"))
        hooks = settings.setdefault("hooks", {})
        for event, entries in claude_hooks(cmd).items():
            kept = [e for e in hooks.get(event, [])
                    if "launchpad hook" not in json.dumps(e)]
            hooks[event] = kept + entries
        path.write_text(json.dumps(settings, indent=2) + "\n")
    step("add launchpad hooks to ~/.claude/settings.json (backup kept)", claude_settings)
    step("write ~/.grok/hooks/launchpad.json",
         lambda: write_json(HOME / ".grok/hooks/launchpad.json", grok_hooks(cmd)))

    def mcp_claude():
        if shutil.which("claude"):
            subprocess.run(["claude", "mcp", "remove", "-s", "user", "launchpad"], capture_output=True)
            subprocess.run(["claude", "mcp", "add", "-s", "user", "launchpad", "--", cmd, "mcp"],
                           check=True, capture_output=True)
    step("register the MCP server with Claude Code (user scope)", mcp_claude)

    def mcp_toml(path, header):
        if not path.parent.exists():
            return
        text = path.read_text() if path.exists() else ""
        if header not in text:
            with open(path, "a") as f:
                f.write(f"\n{header}\ncommand = \"{cmd}\"\nargs = [\"mcp\"]\n")
    step("register the MCP server with Grok (~/.grok/config.toml)",
         lambda: mcp_toml(HOME / ".grok/config.toml", "[mcp_servers.launchpad]"))
    step("register the MCP server with Codex, if installed (~/.codex/config.toml)",
         lambda: mcp_toml(HOME / ".codex/config.toml", "[mcp_servers.launchpad]"))

    def kitty_conf():
        path = HOME / ".config/kitty/kitty.conf"
        text = path.read_text() if path.exists() else ""
        if "# >>> launchpad" not in text:
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, "a") as f:
                f.write(KITTY_BLOCK)
    step("turn on kitty remote control (~/.config/kitty/kitty.conf, new windows only)", kitty_conf)

    def services():
        unit_dir = HOME / ".config/systemd/user"
        unit_dir.mkdir(parents=True, exist_ok=True)
        for unit in ("launchpad.service", "push-courier.service"):
            link_path = unit_dir / unit
            link_path.unlink(missing_ok=True)
            link_path.symlink_to(here / "systemd" / unit)
        for old in ("relay-protocol.service", "relay-scheduler.service"):
            subprocess.run(["systemctl", "--user", "disable", "--now", old], capture_output=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        subprocess.run(["systemctl", "--user", "enable", "--now", "launchpad.service",
                        "push-courier.service"], check=True, capture_output=True)
    step("install and start launchpad.service and push-courier.service", services)

    for text, _ in steps:
        print(f"  - {text}")
    if not yes:
        print("\nNothing changed yet. Run `launchpad install --yes` to do the above.")
        return
    for text, action in steps:
        action()
        print(f"done: {text}")
    print("\nOpen new kitty windows for the agents so they pick up remote control.")


