# -----------------------------------------------------------------------------
#
# Newline-delimited JSON-RPC 2.0 on stdin/stdout (the MCP stdio transport).

MCP_TOOLS = [
    {"name": "send_message",
     "description": "Send a note to another agent on this desktop. It's delivered within "
                    "seconds: at the end of their current turn, or typed into their window "
                    "if they're idle. Use quiet for FYIs that shouldn't wake anyone.",
     "inputSchema": {"type": "object", "required": ["to", "text"], "properties": {
         "to": {"type": "string", "enum": list(SEATS) + ["all"],
                "description": "A seat, 'owner' (desktop notification) or 'all' agents."},
         "text": {"type": "string"},
         "quiet": {"type": "boolean", "description": "Don't wake them; they get it next time."},
         "private": {"type": "boolean", "description": "Keep out of the public log and Discord."}}}},
    {"name": "read_messages",
     "description": "Take and show every note waiting for you, including quiet ones.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "add_note",
     "description": "Add to the team's running commentary: what you did and why.",
     "inputSchema": {"type": "object", "required": ["text"],
                     "properties": {"text": {"type": "string"}}}},
    {"name": "team_status",
     "description": "Which agents are busy, idle or away, and how many notes wait for each.",
     "inputSchema": {"type": "object", "properties": {}}},
]


def mcp_call(seat, name, args):
    """Run one MCP tool. Returns (text, is_error)."""
    if name == "send_message":
        record, warning = send(seat, str(args.get("to", "")), str(args.get("text", "")),
                               bool(args.get("quiet")), bool(args.get("private")))
        return (f"Sent to {record['to']}." + (f" {warning}" if warning else "")), False
    if name == "read_messages":
        notes = take(seat)
        return (render(notes, seat) if notes else "No notes waiting."), False
    if name == "add_note":
        add_note(seat, str(args.get("text", "")))
        return "Added to the commentary.", False
    if name == "team_status":
        return status_text(), False
    return f"Unknown tool {name}", True


def mcp():
    """Serve MCP on stdin/stdout until stdin closes."""
    seat, pid = find_agent()
    seat = seat or "unknown"
    if pid:
        remember_window(seat, pid)
    out = sys.stdout

    def answer(msg_id, result=None, error=None):
        reply = {"jsonrpc": "2.0", "id": msg_id}
        reply.update({"error": error} if error else {"result": result})
        out.write(json.dumps(reply) + "\n")
        out.flush()

    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        method, msg_id = msg.get("method"), msg.get("id")
        if msg_id is None:
            continue  # a notification, e.g. notifications/initialized
        if method == "initialize":
            answer(msg_id, {
                "protocolVersion": (msg.get("params") or {}).get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "launchpad", "version": "2.0"},
                "instructions": f"You are the '{seat}' seat. Notes from other agents arrive "
                                f"on their own, starting with {MARK}. Use send_message to reply."})
        elif method == "tools/list":
            answer(msg_id, {"tools": MCP_TOOLS})
        elif method == "tools/call":
            params = msg.get("params") or {}
            try:
                text, failed = mcp_call(seat, params.get("name"), params.get("arguments") or {})
            except ValueError as error:
                text, failed = str(error), True
            answer(msg_id, {"content": [{"type": "text", "text": text}], "isError": failed})
        elif method == "ping":
            answer(msg_id, {})
        else:
            answer(msg_id, error={"code": -32601, "message": f"no method {method}"})


