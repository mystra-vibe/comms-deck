def self_test():
    """Check the mailbox, hooks, loop guard and MCP server. Exit 1 on failure."""
    tmp = tempfile.mkdtemp(prefix="launchpad-test-")
    env = dict(os.environ, LAUNCHPAD_HOME=f"{tmp}/data", LAUNCHPAD_CONFIG=f"{tmp}/config",
               LAUNCHPAD_AUTO_LIMIT="2")
    me = str(Path(__file__).resolve())
    failures = []

    def run(args, seat, stdin="", extra=None):
        e = dict(env, LAUNCHPAD_SEAT=seat, **(extra or {}))
        return subprocess.run([sys.executable, me, *args], input=stdin, env=e,
                              capture_output=True, text=True, timeout=30)

    def check(name, ok, detail=""):
        print(("ok   " if ok else "FAIL ") + name)
        if not ok:
            failures.append(name)
            print("     " + detail.strip().replace("\n", "\n     "))

    r = run(["send", "grok", "hello grok"], "claude")
    check("send", r.returncode == 0, r.stderr)
    r = run(["read", "--peek"], "grok")
    check("peek leaves the note", "hello grok" in r.stdout and
          len(list(Path(f"{tmp}/data/inbox/grok").glob("*.json"))) == 1, r.stdout + r.stderr)
    r = run(["hook", "--source", "grok", "--event", "Stop"], "grok", "{}", {"GROK_HOOK_EVENT": "stop"})
    reply = json.loads(r.stdout or "{}")
    check("Stop hook hands the note over", reply.get("decision") == "block" and
          "hello grok" in reply.get("reason", ""), r.stdout + r.stderr)
    r = run(["hook", "--source", "grok", "--event", "Stop"], "grok", "{}", {"GROK_HOOK_EVENT": "stop"})
    check("empty inbox: Stop hook stays silent", r.stdout.strip() == "", r.stdout)
    r = run(["hook", "--source", "claude", "--event", "Stop"], "grok", "{}", {"GROK_HOOK_EVENT": "stop"})
    check("Claude's hook does nothing inside Grok", r.stdout.strip() == "", r.stdout)
    run(["send", "grok", "--quiet", "fyi only"], "claude")
    r = run(["hook", "--source", "grok", "--event", "Stop"], "grok", "{}", {"GROK_HOOK_EVENT": "stop"})
    check("a quiet note doesn't keep the agent working", r.stdout.strip() == "", r.stdout)
    run(["send", "grok", "second"], "claude")
    r = run(["hook", "--source", "grok", "--event", "Stop"], "grok", "{}", {"GROK_HOOK_EVENT": "stop"})
    check("the quiet note rides along with a normal one", "fyi only" in r.stdout and "second" in r.stdout,
          r.stdout)
    run(["send", "grok", "third"], "claude")
    r = run(["hook", "--source", "grok", "--event", "Stop"], "grok", "{}", {"GROK_HOOK_EVENT": "stop"})
    check("loop guard pauses after the limit", r.stdout.strip() == "", r.stdout)
    run(["hook", "--source", "grok", "--event", "UserPromptSubmit"], "grok",
        '{"prompt": "carry on"}', {"GROK_HOOK_EVENT": "user_prompt_submit"})
    r = run(["hook", "--source", "grok", "--event", "Stop"], "grok", "{}", {"GROK_HOOK_EVENT": "stop"})
    check("an owner prompt resets the loop guard", "third" in r.stdout, r.stdout)
    run(["send", "claude", "for claude"], "grok")
    r = run(["hook", "--source", "claude", "--event", "UserPromptSubmit"], "claude", '{"prompt": "hi"}')
    check("Claude gets notes with the owner's prompt", "for claude" in r.stdout, r.stdout + r.stderr)
    r = run(["send", "grok", "token: abc123secret"], "claude")
    check("secret-looking notes go private", "private" in r.stdout and
          not list(Path(f"{tmp}/data").glob("queue/discord/*")), r.stdout)
    r = run(["send", "nobody", "x"], "claude")
    check("unknown seat is refused", r.returncode != 0)
    rpc = "\n".join(json.dumps(m) for m in [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18"}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list"},
        {"jsonrpc": "2.0", "id": 3, "method": "tools/call",
         "params": {"name": "send_message", "arguments": {"to": "claude", "text": "via mcp"}}},
    ]) + "\n"
    r = run(["mcp"], "grok", rpc)
    replies = [json.loads(line) for line in r.stdout.splitlines()]
    check("MCP server answers initialize, tools/list and tools/call",
          len(replies) == 3 and replies[1]["result"]["tools"][0]["name"] == "send_message"
          and not replies[2]["result"]["isError"], r.stdout + r.stderr)
    r = run(["read"], "claude")
    check("note sent over MCP arrives", "via mcp" in r.stdout, r.stdout)
    shutil.rmtree(tmp, ignore_errors=True)
    print(f"\n{'all passed' if not failures else f'{len(failures)} failed'}")
    return 1 if failures else 0


