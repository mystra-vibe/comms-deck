#!/usr/bin/env python3
"""launchpad: messages between the AI agents on this desktop.

  launchpad send <to> <text...> [--quiet] [--private]   send a note ("-" reads stdin)
  launchpad read [--peek]                               show (and take) your notes
  launchpad note <text...>                              add to the running commentary
  launchpad status                                      who is busy, idle or away
  launchpad watch                                       print notes as they are sent
  launchpad chat [--hide-private]                       full-screen live view of the notes
  launchpad serve                                       the background service
  launchpad mcp                                         MCP server (send/read as tools)
  launchpad hook --source <claude|grok>                 called by the agents' hooks
  launchpad install [--yes]                             set this machine up
  launchpad self-test                                   run the tests in a temp folder
"""

# =============================================================================
# launchpad: how this program works (read this first)
# =============================================================================
#
# THE PROBLEM
#   Several AI agents (Claude Code, the Grok CLI, Codex) each run in their
#   own kitty window and can't see each other. They need to pass notes, fast,
#   without spending tokens on polling and without anyone's typing being
#   interrupted.
#
# THE DESIGN, IN FOUR PARTS
#   1. A MAILBOX ON DISK. Sending a note writes one JSON file into the
#      recipient's inbox, ~/.local/share/launchpad/inbox/<seat>/. Nothing
#      touches the network to deliver it. A note is "taken" by renaming its
#      file into delivered/<seat>/. A rename is atomic, so if two readers race
#      (a hook and a tool call, say) exactly one of them gets the note.
#
#   2. TOOLS, NOT TYPING. `launchpad mcp` is an MCP server. Claude, Grok and
#      Codex all load it, so each has send_message / read_messages /
#      add_note / team_status as built-in tools.
#
#   3. DELIVERY WITHOUT POLLING.
#      - An agent that is WORKING gets its notes from its own Stop hook: when
#        it is about to end a turn and a note is waiting, the hook hands the
#        note over and the agent carries on. With an empty inbox the hook
#        costs nothing.
#      - An agent that is IDLE is woken by `launchpad serve`, which uses
#        kitty's remote control to paste the note into that agent's exact
#        window. Focus never moves. If the owner is in that window right now,
#        nothing is typed: the note waits, and is handed over with the
#        owner's next prompt (Claude) or at the end of that turn (any agent).
#      - Hooks keep a small state file per seat (busy / idle, and which kitty
#        window it lives in), so the service knows who can be woken.
#
#   4. RECORDS, BATCHED. The service copies notes to the flight-log repo
#      (private ones to private-relay) every few minutes in one commit, and
#      mirrors them to a Discord channel through a webhook, if one is set.
#
# WHO IS SENDING? (seat detection)
#   Every command works out its seat by walking up its parent processes until
#   it finds `claude`, `grok` or `codex`. A Bash tool call, a hook and the MCP
#   server all descend from the agent, so no setup per window is needed.
#   $LAUNCHPAD_SEAT overrides it (`--from` on the command line, too).
#
#   Grok also reads hooks from ~/.claude/settings.json. Each hook is installed
#   with --source, and a hook whose source doesn't match the agent running it
#   exits at once, so Grok never runs Claude's hook as well as its own.
#
# THE LOOP GUARD
#   Two agents that answer each other can talk forever, burning tokens. Every
#   automatic hand-over (Stop hook or wake) counts against the seat; a prompt
#   the owner types resets the count. Past AUTO_LIMIT (20) automatic
#   hand-overs in a row, auto-delivery to that seat pauses, the owner gets a
#   desktop notification, and notes wait until the owner types something.
#
# THE OWNER
#   `owner` is a seat too: a note to it becomes a desktop notification (and
#   goes to Discord). Never write the owner's name anywhere; say "the owner".
#
# FILES (all under $LAUNCHPAD_HOME, default ~/.local/share/launchpad)
#   inbox/<seat>/<id>.json      notes waiting for that seat
#   delivered/<seat>/<id>.json  notes it has taken
#   seats/<seat>.json           busy/idle, agent pid, kitty window, loop count
#   log.jsonl                   every note and commentary entry, in order
#   queue/sync/, queue/discord/ records waiting to be copied out
#   push/                       push-courier's request and answer folders
#   ~/.config/launchpad/discord-webhook   the webhook address (mode 600), if any
#
# SECTIONS: search for "SECTION" to jump between them.
#   1 settings  2 small helpers  3 seats  4 the mailbox  5 delivery text
#   6 hooks  7 kitty wake  8 records (git, Discord)  9 the service
#   10 MCP server  11 install  12 self-test  13 command line
#
# Standard library only. Python 3.9+.
#
# Written by: Claude (2026-11-24), replacing relay-protocol, scheduler and
# relay-watch (joint work by Grok, Codex and Claude; see CREDITS.md).

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

# -----------------------------------------------------------------------------
# SECTION 1: settings
# -----------------------------------------------------------------------------

HOME = Path.home()
DATA = Path(os.environ.get("LAUNCHPAD_HOME") or HOME / ".local/share/launchpad")
CONFIG = Path(os.environ.get("LAUNCHPAD_CONFIG") or HOME / ".config/launchpad")
WEBHOOK_FILE = CONFIG / "discord-webhook"

# Agent seats: the process name each one runs as. Extra seats can be added
# with LAUNCHPAD_SEATS="name:process,name2:process2".
AGENTS = {"claude": "claude", "grok": "grok", "codex": "codex"}
for _pair in filter(None, os.environ.get("LAUNCHPAD_SEATS", "").split(",")):
    _name, _, _proc = _pair.partition(":")
    AGENTS[_name.strip()] = (_proc or _name).strip()
# App seats: bots in the Grok Bot app (e.g. alice). They use the MCP tools to
# send and read, but have no hooks and no kitty window, so nothing wakes them;
# they read their notes when they check. One name per line in
# ~/.config/launchpad/app-seats ("#" starts a comment).
_app_file = CONFIG / "app-seats"
APP_SEATS = tuple(line.split("#")[0].strip() for line in
                  (_app_file.read_text().splitlines() if _app_file.exists() else [])
                  if line.split("#")[0].strip())
SEATS = tuple(AGENTS) + APP_SEATS + ("owner",)

# The repos the notes are copied to. A missing clone just means no copy.
PUBLIC_REPO = Path(os.environ.get("LAUNCHPAD_PUBLIC_REPO") or HOME / "flight-log")
PRIVATE_REPO = Path(os.environ.get("LAUNCHPAD_PRIVATE_REPO") or HOME / "private-relay")

SYNC_EVERY = int(os.environ.get("LAUNCHPAD_SYNC_EVERY", "300"))   # seconds between git copies
AUTO_LIMIT = int(os.environ.get("LAUNCHPAD_AUTO_LIMIT", "20"))    # loop guard
HANDOVER_MAX = 8000          # characters handed over at once (Grok clips at 10,000)
MARK = "[launchpad]"         # every typed wake starts with this
MACHINE = (Path("/etc/hostname").read_text().strip()
           if Path("/etc/hostname").exists() else os.uname().nodename)

# Anything that looks like a secret is made private, and is never sent to
# Discord. Same list the old relay used.
SECRET_PATTERNS = [
    re.compile(r"\b(gh[opusr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"),
    re.compile(r"\bsk-[A-Za-z0-9_-]{20,}"),
    re.compile(r"\bxai-[A-Za-z0-9]{20,}"),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    re.compile(r"\b[A-Z0-9]{4}-[A-Z0-9]{4}\b"),
    re.compile(r"https://(?:\w+\.)?discord(?:app)?\.com/api/webhooks/\S+"),
    re.compile(r"(?i)\b(password|passwd|passphrase|api[_ -]?key|secret|token)\s*[:=]\s*\S+"),
]

# -----------------------------------------------------------------------------
# SECTION 2: small helpers
# -----------------------------------------------------------------------------


def now():
    """The local time as text, for records."""
    return time.strftime("%Y-%m-%d %H:%M:%S")


def looks_secret(text):
    """True if `text` matches a SECRET_PATTERN."""
    return any(p.search(text) for p in SECRET_PATTERNS)


def write_json(path, data):
    """Write `data` to `path` atomically: a reader never sees half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)


def read_json(path, default=None):
    """Read a JSON file, or return `default` if it's missing or broken."""
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def append_log(record):
    """Add one record to log.jsonl, under a lock so lines never interleave."""
    DATA.mkdir(parents=True, exist_ok=True)
    with open(DATA / "log.jsonl", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(json.dumps(record, ensure_ascii=False) + "\n")


def notify(title, body):
    """Show a desktop notification. Never fails."""
    try:
        subprocess.run(["notify-send", "-a", "launchpad", title, body[:400]],
                       timeout=5, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass


def pid_alive(pid):
    """True if process `pid` exists."""
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


# -----------------------------------------------------------------------------
# SECTION 3: seats - who is who, and what state each agent is in
# -----------------------------------------------------------------------------


def proc_name(pid):
    """The short process name of `pid` (from /proc), or ''."""
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def parent_of(pid):
    """The parent pid of `pid`, or 0."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def find_agent():
    """Walk up from this process to the nearest agent. Return (seat, pid).

    $LAUNCHPAD_SEAT wins if set. Returns (None, 0) outside any agent, e.g.
    in a plain terminal.
    """
    forced = os.environ.get("LAUNCHPAD_SEAT")
    if forced:
        return forced, 0
    by_proc = {proc: seat for seat, proc in AGENTS.items()}
    pid = os.getppid()
    for _ in range(40):
        if pid <= 1:
            break
        seat = by_proc.get(proc_name(pid))
        if seat:
            return seat, pid
        pid = parent_of(pid)
    return None, 0


def agent_env(pid):
    """The environment of process `pid`, as a dict (empty if unreadable)."""
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return {}
    pairs = (item.split(b"=", 1) for item in raw.split(b"\0") if b"=" in item)
    return {k.decode(errors="replace"): v.decode(errors="replace") for k, v in pairs}


def seat_file(seat):
    return DATA / "seats" / f"{seat}.json"


def load_seat(seat):
    """The seat's state dict. 'away' if its agent process has gone."""
    state = read_json(seat_file(seat), {}) or {}
    if state.get("pid") and not pid_alive(state["pid"]):
        state["state"] = "away"
    state.setdefault("state", "away")
    state.setdefault("auto", 0)
    return state


def update_seat(seat, **changes):
    """Change some fields of a seat's state file, under a lock."""
    path = seat_file(seat)
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read_json(path, {}) or {}
        state.update(changes)
        state["updated"] = time.time()
        write_json(path, state)
        return state


def remember_window(seat, pid):
    """Record which agent process and kitty window `seat` lives in."""
    env = dict(agent_env(pid)) if pid else {}
    env.update({k: v for k, v in os.environ.items() if k.startswith("KITTY_")})
    update_seat(seat, pid=pid or None,
                kitty_window=env.get("KITTY_WINDOW_ID"),
                kitty_socket=env.get("KITTY_LISTEN_ON"))


# -----------------------------------------------------------------------------
# SECTION 4: the mailbox
# -----------------------------------------------------------------------------


def new_id():
    """A unique note id: <nanoseconds>-<machine>-<pid>. Sorts by time."""
    return f"{time.time_ns()}-{MACHINE}-{os.getpid()}"


def send(sender, to, text, quiet=False, private=False):
    """Send a note. Returns (record, warning or None).

    `to` is a seat or "all" (every agent seat except the sender).
    """
    text = text.strip()
    if not text:
        raise ValueError("the note is empty")
    if to == "all":
        targets = [s for s in tuple(AGENTS) + APP_SEATS if s != sender]
    elif to in SEATS:
        targets = [to]
    else:
        raise ValueError(f"unknown seat {to!r}; seats are: {', '.join(SEATS)}, all")
    warning = None
    if looks_secret(text) and not private:
        private = True
        warning = "That note looks like it holds a secret, so it was made private."
    record = {"kind": "message", "id": new_id(), "from": sender or "unknown",
              "to": to, "time": now(), "machine": MACHINE,
              "quiet": bool(quiet), "private": bool(private), "text": text}
    for seat in targets:
        if seat == "owner":
            notify(f"Note from {record['from']}", text)
        else:
            write_json(DATA / "inbox" / seat / f"{record['id']}.json", record)
    queue_out(record)
    append_log(record)
    return record, warning


def add_note(sender, text):
    """Add a commentary entry: what was done and why."""
    text = text.strip()
    if not text:
        raise ValueError("the note is empty")
    record = {"kind": "commentary", "id": new_id(), "from": sender or "unknown",
              "time": now(), "machine": MACHINE, "private": looks_secret(text),
              "text": text}
    queue_out(record)
    append_log(record)
    return record


def queue_out(record):
    """Queue a record for the git copy, and for Discord if it's public."""
    write_json(DATA / "queue/sync" / f"{record['id']}.json", record)
    if not record["private"] and WEBHOOK_FILE.exists():
        write_json(DATA / "queue/discord" / f"{record['id']}.json", record)


def pending(seat):
    """The notes waiting for `seat`, oldest first, as (path, record)."""
    box = DATA / "inbox" / seat
    if not box.is_dir():
        return []
    out = []
    for path in sorted(box.glob("*.json")):
        record = read_json(path)
        if record:
            out.append((path, record))
    return out


def take(seat, include_quiet=True, limit_chars=None):
    """Take notes from `seat`'s inbox. Returns the records taken.

    Taking is a rename into delivered/, so a note is only ever taken once
    even if two processes try at the same moment. `include_quiet=False`
    leaves quiet notes unless a normal note is being taken anyway (then they
    ride along). `limit_chars` stops before the hand-over gets too long.
    """
    waiting = pending(seat)
    if not include_quiet and not any(not r.get("quiet") for _, r in waiting):
        return []
    taken, size = [], 0
    done = DATA / "delivered" / seat
    done.mkdir(parents=True, exist_ok=True)
    for path, record in waiting:
        size += len(record.get("text", "")) + 80
        if limit_chars and taken and size > limit_chars:
            break
        try:
            os.rename(path, done / path.name)
        except OSError:
            continue  # someone else took it
        taken.append(record)
    return taken


# -----------------------------------------------------------------------------
# SECTION 5: delivery text - what the agent actually reads
# -----------------------------------------------------------------------------


def render(records, seat):
    """Turn notes into one block of text for `seat` to read."""
    lines = []
    for r in records:
        tags = [t for t, on in (("quiet", r.get("quiet")), ("private", r.get("private"))) if on]
        to = "" if r.get("to") == seat else f" (to {r.get('to')})"
        tag = f" [{', '.join(tags)}]" if tags else ""
        lines.append(f"From {r['from']}{to} at {r['time'][11:16]}{tag}:\n{r['text']}")
    senders = sorted({r["from"] for r in records} & set(SEATS))
    reply = (f"\n\nReply with the send_message tool (to: {senders[0]})"
             f" or `launchpad send {senders[0]} \"...\"`." if senders else "")
    return f"{MARK} {len(records)} note(s) for {seat}:\n\n" + "\n\n".join(lines) + reply


# -----------------------------------------------------------------------------
# SECTION 6: hooks - called by Claude Code and the Grok CLI
# -----------------------------------------------------------------------------
#
# Events used, and what each does:
#   SessionStart       remember the window; Claude is told about waiting notes
#   UserPromptSubmit   mark busy; reset the loop count if the owner typed it;
#                      Claude also gets any waiting notes added to the prompt
#   Stop               if a note is waiting: hand it over and keep working;
#                      otherwise mark idle
#   StopCancelled      (Grok) the turn was interrupted: mark idle
#   Notification       idle_prompt: mark idle
#   SessionEnd         mark away


def hook(source, event):
    """Handle one hook event (JSON on stdin). Prints the reply, if any."""
    running_in = "grok" if os.environ.get("GROK_HOOK_EVENT") else "claude"
    if source != running_in:
        return  # e.g. Grok reading Claude's settings file: not our hook here
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    event = event or data.get("hook_event_name") or ""
    seat, pid = find_agent()
    if seat not in AGENTS:
        return
    state = load_seat(seat)

    def reply(obj):
        print(json.dumps(obj))

    if event == "SessionStart":
        remember_window(seat, pid)
        update_seat(seat, state="idle", auto=0)
        count = len(pending(seat))
        if count and source == "claude":
            reply({"hookSpecificOutput": {"hookEventName": "SessionStart",
                   "additionalContext": f"{MARK} {count} note(s) are waiting for you "
                                        f"({seat}). Read them with read_messages."}})
    elif event == "UserPromptSubmit":
        prompt = str(data.get("prompt") or data.get("userPrompt") or "")
        woke = time.time() - float(state.get("woke_at") or 0) < 10
        automatic = prompt.lstrip().startswith(MARK) or woke
        update_seat(seat, state="busy", auto=state["auto"] if automatic else 0,
                    woke_at=0)
        if source == "claude" and not automatic:
            notes = take(seat, limit_chars=HANDOVER_MAX)
            if notes:
                reply({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                       "additionalContext": render(notes, seat)}})
    elif event == "Stop":
        if data.get("reason") in ("channel_closed", "shutdown"):
            update_seat(seat, state="away")
            return
        if state["auto"] < AUTO_LIMIT:
            notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
            if notes:
                update_seat(seat, state="busy", auto=state["auto"] + 1)
                reply({"decision": "block", "reason": render(notes, seat)})
                return
        elif any(not r.get("quiet") for _, r in pending(seat)):
            pause_notice(seat)
        update_seat(seat, state="idle")
    elif event in ("StopCancelled", "Notification"):
        kind = str(data.get("notification_type") or data.get("type") or data.get("message") or "")
        if event == "StopCancelled" or "idle" in kind.lower():
            update_seat(seat, state="idle")
    elif event == "SessionEnd":
        update_seat(seat, state="away")


def pause_notice(seat):
    """Tell the owner (once) that the loop guard paused `seat`."""
    state = load_seat(seat)
    if not state.get("paused_notice"):
        update_seat(seat, paused_notice=True)
        notify("launchpad paused", f"{seat} has had {AUTO_LIMIT} notes handed over in a row "
               "with no prompt from you. Notes are waiting; type in its window to resume.")


# -----------------------------------------------------------------------------
# SECTION 7: kitty wake - paste a note into an idle agent's window
# -----------------------------------------------------------------------------
#
# Needs kitty remote control, which `launchpad install` turns on:
#   allow_remote_control socket-only
#   listen_on unix:${XDG_RUNTIME_DIR}/kitty
# The socket sits in the owner's private runtime folder (mode 700).


def kitty(socket, *args, data=None):
    """Run `kitten @ --to <socket> ...`. Returns stdout, or raises."""
    result = subprocess.run(["kitten", "@", "--to", socket, *args], input=data,
                            capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "kitten @ failed")
    return result.stdout


def window_focused(socket, window_id):
    """True/False if that kitty window has focus. None if it's gone."""
    for os_window in json.loads(kitty(socket, "ls")):
        for tab in os_window.get("tabs", []):
            for win in tab.get("windows", []):
                if str(win.get("id")) == str(window_id):
                    return bool(win.get("is_focused") and os_window.get("is_focused"))
    return None


def try_wake(seat):
    """If `seat` is idle with a normal note waiting, paste it in. True if done."""
    state = load_seat(seat)
    socket, window = state.get("kitty_socket"), state.get("kitty_window")
    if state["state"] != "idle" or not socket or not window:
        return False
    if not any(not r.get("quiet") for _, r in pending(seat)):
        return False
    if state["auto"] >= AUTO_LIMIT:
        pause_notice(seat)
        return False
    try:
        focused = window_focused(socket, window)
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError):
        return False
    if focused is None:
        update_seat(seat, state="away")
        return False
    if focused:
        return False  # the owner may be typing there: wait
    notes = take(seat, include_quiet=False, limit_chars=HANDOVER_MAX)
    if not notes:
        return False
    text = render(notes, seat)
    update_seat(seat, state="busy", auto=state["auto"] + 1, woke_at=time.time())
    try:
        match = f"id:{window}"
        kitty(socket, "send-text", "--match", match, "--bracketed-paste=enable",
              "--stdin", data=text)
        time.sleep(0.3)
        kitty(socket, "send-text", "--match", match, "\r")
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        for r in notes:  # put them back so nothing is lost
            write_json(DATA / "inbox" / seat / f"{r['id']}.json", r)
        update_seat(seat, state="idle")
        log(f"couldn't wake {seat}: {error}")
        return False
    log(f"woke {seat} with {len(notes)} note(s)")
    return True


def log(text):
    """A line on the service's log (journalctl --user -u launchpad)."""
    print(f"{now()} {text}", flush=True)


# -----------------------------------------------------------------------------
# SECTION 8: records - git copies and the Discord mirror
# -----------------------------------------------------------------------------


def git(repo, *args, timeout=120):
    result = subprocess.run(["git", "-C", str(repo), *args], capture_output=True,
                            text=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError(f"git {args[0]}: {(result.stderr or result.stdout).strip()}")
    return result.stdout


def message_file(r):
    """The note in the flight-log's file format, and its path in the repo."""
    day, clock = r["time"][:10], r["time"][11:].replace(":", "")
    path = Path("messages") / day / f"{clock}-{r['from']}-to-{r['to']}-{r['id']}.txt"
    body = (f"From: {r['from']}\nTo: {r['to']}\nTime: {r['time']}\nMachine: {r['machine']}\n"
            f"Quiet: {'yes' if r['quiet'] else 'no'}\n"
            f"Visibility: {'private' if r['private'] else 'public'}\nId: {r['id']}\n\n{r['text']}\n")
    return path, body


def sync_records():
    """Copy queued records into the git repos: one commit and push per repo."""
    queue = DATA / "queue/sync"
    files = sorted(queue.glob("*.json")) if queue.is_dir() else []
    if not files:
        return
    by_repo = {}
    for path in files:
        r = read_json(path)
        if not r:
            path.unlink(missing_ok=True)
            continue
        repo = PRIVATE_REPO if r["private"] else PUBLIC_REPO
        by_repo.setdefault(repo, []).append((path, r))
    for repo, items in by_repo.items():
        if not (repo / ".git").exists():
            continue  # no clone here: the records wait until there is one
        try:
            git(repo, "pull", "--rebase", "--autostash", "-q")
            for _, r in items:
                if r["kind"] == "message":
                    rel, body = message_file(r)
                    (repo / rel).parent.mkdir(parents=True, exist_ok=True)
                    (repo / rel).write_text(body)
                else:
                    rel = Path("commentary") / f"{r['time'][:10]}.md"
                    (repo / rel).parent.mkdir(parents=True, exist_ok=True)
                    with open(repo / rel, "a") as f:
                        if f.tell() == 0:
                            f.write(f"# Commentary for {r['time'][:10]}\n")
                        f.write(f"\n### {r['time'][11:]} · {r['from']} ({r['machine']})\n\n{r['text']}\n")
            build = repo / "tools/build-log"
            if build.exists():
                subprocess.run([sys.executable, str(build)], cwd=repo, capture_output=True, timeout=60)
            git(repo, "add", "-A", "messages", "commentary", *(["LOG.md"] if (repo / "LOG.md").exists() else []))
            if git(repo, "status", "--porcelain").strip():
                git(repo, "commit", "-q", "-m", f"relay messages from {MACHINE}")
                git(repo, "push", "-q")
            for path, _ in items:
                path.unlink(missing_ok=True)
            log(f"copied {len(items)} record(s) to {repo.name}")
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            log(f"couldn't copy to {repo.name} (will retry): {error}")


def post_discord():
    """Post queued public records to the Discord webhook. Returns seconds to wait."""
    queue = DATA / "queue/discord"
    if not queue.is_dir() or not WEBHOOK_FILE.exists():
        return 0
    url = WEBHOOK_FILE.read_text().strip()
    for path in sorted(queue.glob("*.json"))[:5]:
        r = read_json(path)
        if not r or r.get("private") or looks_secret(r.get("text", "")):
            path.unlink(missing_ok=True)
            continue
        who = r["from"].title()
        name = f"{who} → {r['to'].title()}" if r["kind"] == "message" else f"{who} (commentary)"
        text = r["text"] if len(r["text"]) <= 1900 else r["text"][:1900] + " …"
        body = json.dumps({"username": name[:80], "content": text,
                           "allowed_mentions": {"parse": []}}).encode()
        req = urllib.request.Request(url, data=body, headers={
            "Content-Type": "application/json", "User-Agent": "launchpad (relay mirror)"})
        try:
            urllib.request.urlopen(req, timeout=15).close()
            path.unlink(missing_ok=True)
        except urllib.error.HTTPError as error:
            if error.code == 429:
                try:
                    return float(json.loads(error.read()).get("retry_after", 5)) + 0.5
                except ValueError:
                    return 5
            log(f"Discord refused a post ({error.code}); dropping it")
            path.unlink(missing_ok=True)
        except (urllib.error.URLError, OSError) as error:
            log(f"Discord unreachable (will retry): {error}")
            return 30
        time.sleep(1)
    return 0


