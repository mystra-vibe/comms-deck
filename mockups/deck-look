#!/usr/bin/env python3
"""deck-look: a mock-up of comms-deck's new look, drawn from the live deck.

The owner (08:03, 2026-11-25) wants comms-deck to look a bit like the
dashboard in Argona's video: numbered panels with corner brackets and an
accent colour each, a strip of big numbers along the top, a node graph,
and a ticker along the bottom. And (08:03) none of the data the chat
screen shows today may be lost.

So this mock-up keeps every existing panel's content -- it calls the
deck's own usage_panel, activity_panel (activity, tasks, the context
split), notify_lines and chat_lines -- and changes only how they're
framed, adding:
  - a header strip: seats, working, notes today, waiting, context, cost, version
  - 01 CREW: a live graph, each seat a cluster in its colour sized by its
    context, notes of the last 30 min drawn as links with a moving packet
  - a ticker of the latest notes along the bottom

It only reads. Run it in a terminal; q or Ctrl-C quits.
  deck-look [path/to/comms-deck]
Written by: Claude (2026-11-25)
"""

import hashlib
import importlib.machinery
import importlib.util
import json
import math
import os
import select
import sys
import termios
import time
import tty
from pathlib import Path

src = sys.argv[1] if len(sys.argv) > 1 else str(Path.home() / "comms-deck" / "comms-deck")
_loader = importlib.machinery.SourceFileLoader("deck", src)
_spec = importlib.util.spec_from_loader("deck", _loader)
x = importlib.util.module_from_spec(_spec)
_loader.exec_module(x)

E = "\033["
FRAME = 238          # the thin border
PANEL = {            # each panel's accent, like the reference's per-panel colours
    "crew": 208, "activity": 45, "notes": 255, "usage": 220,
    "tasks": 141, "split": 213, "alerts": 203,
}


def vis(s):
    return x.visible_len(s)


def frame(num, title, sub, right, accent, w, h, body):
    """One panel: bright corner brackets in the accent, a dim border, a
    header line with a numbered badge, then `body` fitted to the inside."""
    iw = max(1, w - 4)
    a, d = f"{E}38;5;{accent}m", f"{E}38;5;{FRAME}m"
    arm = min(3, max(0, (w - 2) // 4))
    top = a + "┌" + "─" * arm + d + "─" * (w - 2 - 2 * arm) + a + "─" * arm + "┐" + E + "0m"
    bot = a + "└" + "─" * arm + d + "─" * (w - 2 - 2 * arm) + a + "─" * arm + "┘" + E + "0m"
    badge = f"{E}48;5;{accent};38;5;232;1m {num} {E}0m"
    head = f"{badge} {E}1;38;5;255m{title}{E}0m" + (f" {E}2m· {sub}{E}0m" if sub else "")
    if right and vis(head) + vis(right) + 1 <= iw:
        head += " " * (iw - vis(head) - vis(right)) + right
    inner = [head, ""] + list(body)
    inner = (inner + [""] * h)[:max(0, h - 2)]
    side_l, side_r = d + "│" + E + "0m ", " " + d + "│" + E + "0m"
    return [top] + [side_l + x.fit(line, iw) + side_r for line in inner] + [bot]


def active_tag(on, word_on="ACTIVE", word_off="IDLE"):
    return (f"{E}38;5;42m● {word_on}{E}0m" if on else f"{E}2m○ {word_off}{E}0m")


# --- the log: notes today, the ticker, the graph's links -----------------

_log = {"at": 0, "size": -1, "recs": []}


def recent_records(n=400):
    """The last n records of log.jsonl, re-read only when the file grows."""
    path = x.DATA / "log.jsonl"
    try:
        size = path.stat().st_size
    except OSError:
        return []
    if size != _log["size"]:
        with open(path, "rb") as f:
            f.seek(max(0, size - 600_000))
            lines = f.read().decode(errors="replace").splitlines()[1:]
        recs = []
        for line in lines[-n:]:
            try:
                recs.append(json.loads(line))
            except ValueError:
                pass
        _log.update(size=size, recs=recs)
    return _log["recs"]


def stamp(r):
    try:
        return time.mktime(time.strptime(r["time"][:19], "%Y-%m-%d %H:%M:%S"))
    except (KeyError, ValueError):
        return 0


# --- 01 CREW: a braille graph ---------------------------------------------

DOT = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))


class Canvas:
    def __init__(self, cols, rows):
        self.cols, self.rows = cols, rows
        self.w, self.h = cols * 2, rows * 4
        self.bits = [[0] * cols for _ in range(rows)]
        self.ink = [[None] * cols for _ in range(rows)]
        self.text = {}

    def plot(self, px, py, style):
        px, py = int(px), int(py)
        if 0 <= px < self.w and 0 <= py < self.h:
            c, r = px // 2, py // 4
            self.bits[r][c] |= DOT[py % 4][px % 2]
            self.ink[r][c] = style

    def line(self, x0, y0, x1, y1, style, step=1.0):
        n = int(max(abs(x1 - x0), abs(y1 - y0)) / step) + 1
        for i in range(n + 1):
            t = i / max(1, n)
            self.plot(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, style)

    def label(self, px, py, s, style):
        c, r = int(px) // 2, int(py) // 4
        c = max(0, min(self.cols - len(s), c - len(s) // 2))
        if 0 <= r < self.rows:
            for i, ch in enumerate(s):
                self.text[(r, c + i)] = (ch, style)

    def lines(self):
        out = []
        for r in range(self.rows):
            row, cur = "", None
            for c in range(self.cols):
                if (r, c) in self.text:
                    ch, st = self.text[(r, c)]
                elif self.bits[r][c]:
                    ch, st = chr(0x2800 + self.bits[r][c]), self.ink[r][c]
                else:
                    ch, st = " ", None
                if st != cur:
                    row += E + "0m" + (f"{E}{st}m" if st else "")
                    cur = st
                row += ch
            out.append(row + E + "0m")
        return out


def seat_pos(i, n, w, h):
    ang = -math.pi / 2 + 2 * math.pi * i / max(1, n)
    return w / 2 + math.cos(ang) * w * 0.38, h / 2 + math.sin(ang) * h * 0.36


def crew_graph(cols, rows, snap, busy, split, now):
    cv = Canvas(cols, rows)
    seats = list(x.AGENTS) + list(x.APP_SEATS)
    pos = {s: seat_pos(i, len(seats), cv.w, cv.h) for i, s in enumerate(seats)}
    pos["owner"] = (cv.w / 2, cv.h / 2)
    tokens = dict(split)
    biggest = max(tokens.values(), default=1)
    phase = now / x.PULSE_EVERY
    # links: notes of the last 30 minutes, brighter when newer
    recent = [r for r in recent_records() if r.get("kind") == "message" and now - stamp(r) < 1800]
    for r in recent:
        a = pos.get(r["from"])
        for to in (seats if r["to"] == "all" else r["to"].split("+")):
            b = pos.get(to)
            if a and b and a != b:
                cv.line(*a, *b, f"38;5;{240 if now - stamp(r) > 300 else x.colour(r['from'])}", step=3)
    # a packet travels each link sent in the last 10 minutes, on a 3 s loop
    for r in recent:
        age = now - stamp(r)
        if age > 600:
            continue
        a = pos.get(r["from"])
        for to in (seats if r["to"] == "all" else r["to"].split("+")):
            b = pos.get(to)
            if a and b and a != b:
                offset = int(hashlib.sha256(r["id"].encode()).hexdigest()[:4], 16) / 65536 * 3
                t = ((now + offset) % 3) / 3
                px, py = a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t
                for dx, dy in ((0, 0), (1, 0), (0, 1), (1, 1)):
                    cv.plot(px + dx, py + dy, f"1;38;5;{x.colour(r['from'])}")
    # clusters: a seat's dots scale with its share of the context pool
    for s in seats:
        cx, cy = pos[s]
        n = int(14 + 140 * math.sqrt(tokens.get(s, 0) / biggest)) if tokens.get(s) else 8
        seed = int(hashlib.sha256(s.encode()).hexdigest(), 16)
        on = s in busy
        for k in range(n):
            h = (seed >> (k % 200)) ^ (k * 2654435761)
            ang = (h % 6283) / 1000 + (now * 0.15 if on else 0)
            spread = 3 + min(cv.w, cv.h) * 0.11 * math.sqrt(n / 154)
            rad = (((h >> 13) % 1000) / 1000) ** 0.6 * spread
            style = x.breathe_style(x.colour(s), k + phase) if on else f"38;5;{x.colour(s)}"
            cv.plot(cx + math.cos(ang) * rad, cy + math.sin(ang) * rad, style)
        st = (snap["seats"].get(s) or {}).get("state", "")
        cv.label(cx, cy + spread + 5, f"[{s}{' ●' if on else ''}]",
                 f"1;38;5;{x.colour(s)}" if st not in ("away", "not set up", "no chat yet") else "2;38;5;244")
    cv.label(*pos["owner"], "( YOU )", "1;38;5;255")
    return cv.lines()


# --- the strip along the top ----------------------------------------------

def stat(label, value, sub, colour_code):
    return (f"{E}2m{label}{E}0m", f"{E}1;38;5;{colour_code}m{value}{E}0m", f"{E}2m{sub}{E}0m")


def header(cols, snap, busy, split):
    recs = recent_records()
    today = time.strftime("%Y-%m-%d")
    notes_today = sum(1 for r in recs if r.get("kind") == "message" and r.get("time", "").startswith(today))
    waiting = sum(len(v) for v in snap["waiting"].values())
    seats = len(x.AGENTS) + len(x.APP_SEATS)
    total = sum(t for _, t in split)
    cost = 0.0
    for s in list(x.AGENTS) + list(x.APP_SEATS):
        c = x.dig((x.read_json(x.DATA / "usage" / f"{s}.json", {}) or {}).get("data", {}), "cost", "total_cost_usd")
        cost += c if isinstance(c, (int, float)) and c > 0 else 0
    ver = x.deck_version() or "?"
    count, _, h = ver.partition("·")
    stats = [stat("SEATS", str(seats), f"{len(busy)} working", 255),
             stat("NOTES TODAY", str(notes_today), "in the log", 45),
             stat("WAITING", str(waiting), "in inboxes", 203 if waiting else 42),
             stat("CONTEXT", x.short_tokens(total) if total else "–", f"{len(split)} reporting", 213),
             stat("COST", f"${cost:,.0f}", "est. sessions", 220),
             stat("VERSION", f"v{count}", h, 141)]
    block = [f"{E}48;5;208;38;5;232;1m  COMMS-DECK   {E}0m",
             f"{E}48;5;208;38;5;232m  starship crew {E}0m", ""]
    title = [f"{E}1;38;5;255mSTARSHIP CREW · LIVE ON {x.MACHINE.upper()}{E}0m",
             f"{E}2mnotes · seats · context · usage · tasks{E}0m", ""]
    cells = [max(vis(a), vis(b), vis(c)) + 4 for a, b, c in stats]
    rows = []
    for i in range(3):
        left = block[i] + "  " + title[i]
        right = "".join(x.fit(s[i], w) for s, w in zip(stats, cells))
        while vis(left) + vis(right) > cols and cells:
            stats, cells = stats[:-1], cells[:-1]   # narrow: drop stats from the right
            right = "".join(x.fit(s[i], w) for s, w in zip(stats, cells))
        rows.append(x.fit(left + " " * max(1, cols - vis(left) - vis(right)) + right, cols))
    return rows


def ticker(cols, now):
    recs = [r for r in recent_records() if r.get("kind") == "message"][-10:]
    if not recs:
        return " " * cols
    items = []
    for r in reversed(recs):
        text = "(private)" if r.get("private") else " ".join(r["text"].split())[:70]
        to = "everyone" if r["to"] == "all" else r["to"].replace("+", ", ")
        items.append((r["from"], f"{r['from']} → {to}: {text}"))
    plain = "".join(f"  ▪  {s}" for _, s in items)
    off = int(now * 8) % len(plain)
    window = (plain * 3)[off:off + cols]
    # colour each sender's name where it shows
    out = window
    for seat, _ in items:
        out = out.replace(f"▪  {seat} →", f"{E}38;5;208m▪{E}0m  {E}1;38;5;{x.colour(seat)}m{seat}{E}0m{E}2m →")
    return f"{E}2m" + x.fit(out, cols)


# --- the existing panels, cut into framed sections ------------------------

def split_activity(lines):
    """activity_panel draws ACTIVITY, then TASKS, then CONTEXT SPLIT and its
    bars in one column. Cut it at those headings so each gets its own frame."""
    parts, name = {"activity": [], "tasks": [], "split": []}, "activity"
    for line in lines:
        plain = x.ANSI.sub("", line).strip()
        if plain == "ACTIVITY":
            continue
        if plain == "TASKS":
            name = "tasks"
            continue
        if plain == "CONTEXT SPLIT":
            name = "split"
            continue
        parts[name].append(line)
    for k in parts:
        while parts[k] and not x.ANSI.sub("", parts[k][0]).strip():
            parts[k].pop(0)
        while parts[k] and not x.ANSI.sub("", parts[k][-1]).strip():
            parts[k].pop()
    return parts


def stack(panels, w, h):
    """Panels one above the other filling h rows. Each is (wanted, maker);
    wanted=None takes what's left (shared equally)."""
    fixed = sum(p for p, _ in panels if p)
    flex = [i for i, (p, _) in enumerate(panels) if not p]
    left = max(0, h - fixed)
    out = []
    for i, (p, make) in enumerate(panels):
        rows = p if p else left // len(flex) + (left % len(flex) if i == flex[-1] else 0)
        if rows >= 3:
            out += make(w, rows)
    return (out + [" " * w] * h)[:h]


def screen(cols, rows, now):
    snap = x.panel_scans()
    busy = x.busy_seats(snap)
    split = x.context_split()
    top = header(cols, snap, busy, split)
    body_h = rows - len(top) - 1
    lw = max(40, int(cols * 0.27))
    rw = max(40, int(cols * 0.27))
    cw = cols - lw - rw
    # left: 01 CREW over 03 USAGE
    usage = x.usage_panel(lw - 4)[2:]
    crew_h = max(10, int(body_h * 0.45))
    left = stack([
        (crew_h, lambda w, h: frame("01", "CREW", "who talks to whom", active_tag(bool(busy), f"{len(busy)} WORKING"),
                                    PANEL["crew"], w, h, crew_graph(w - 4, h - 4, snap, busy, split, now))),
        (None, lambda w, h: frame("03", "USAGE", "context · limits · cost", "",
                                  PANEL["usage"], w, h, x.fit_column(usage, h - 4))),
    ], lw, body_h)
    # centre: 04 LIVE NOTES
    notes = []
    for r in recent_records()[-80:]:
        notes += x.chat_lines(r, cw - 4)
    alerts = [l for l in x.notify_lines(cw - 4) if x.ANSI.sub("", l).strip()][:6]
    centre_panels = [(None, lambda w, h: frame(
        "04", "LIVE NOTES", "the crew's notes, newest last", f"{E}38;5;42m● LIVE{E}0m",
        PANEL["notes"], w, h, notes[-(h - 4):]))]
    if alerts:
        centre_panels.append((len(alerts) + 4, lambda w, h: frame(
            "07", "ALERTS", "desktop notifications", "", PANEL["alerts"], w, h, alerts)))
    centre = stack(centre_panels, cw, body_h)
    # right: 02 ACTIVITY, 05 TASKS, 06 CONTEXT SPLIT
    parts = split_activity(x.activity_panel(rw - 4))
    right_panels = [
        (len(parts["activity"]) + 4, lambda w, h: frame("02", "ACTIVITY", "ready order", active_tag(bool(busy)),
                                                        PANEL["activity"], w, h, parts["activity"]))]
    if parts["tasks"]:
        right_panels.append((len(parts["tasks"]) + 4, lambda w, h: frame(
            "05", "TASKS", "one task, one holder", "", PANEL["tasks"], w, h, parts["tasks"])))
    right_panels.append((None, lambda w, h: frame(
        "06", "CONTEXT SPLIT", "the shared pool", active_tag(bool(busy), "GLOWING", "STILL"),
        PANEL["split"], w, h, x.fit_column(parts["split"], h - 4))))
    right = stack(right_panels, rw, body_h)
    body = [x.fit(left[i], lw) + x.fit(centre[i], cw) + x.fit(right[i], rw) for i in range(body_h)]
    return top + body + [ticker(cols, now)]


def main():
    out = sys.stdout
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd) if os.isatty(fd) else None
    if saved:
        tty.setcbreak(fd)
    out.write("\033[?1049h\033[?25l\033[2J")
    watch = [Path(__file__).resolve(), Path(src).resolve()]
    born = [p.stat().st_mtime for p in watch]
    try:
        while True:
            if [p.stat().st_mtime for p in watch] != born:
                # live edits (the owner, 08:04: see changes happen in real
                # time): a new version of this file or the deck restarts us
                if saved:
                    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
                out.write("\033[0m\033[?25h\033[?1049l")
                out.flush()
                os.execv(sys.executable, [sys.executable] + sys.argv)
            cols, rows = os.get_terminal_size()
            frame_lines = screen(cols, rows, time.time())
            out.write("\033[?2026h\033[H" + "\n".join(x.fit(l, cols) for l in frame_lines[:rows]) + "\033[?2026l")
            out.flush()
            if saved and select.select([sys.stdin], [], [], 0.1)[0]:
                if sys.stdin.read(1) in ("q", "\x03"):
                    break
            elif not saved:
                time.sleep(0.1)
    except KeyboardInterrupt:
        pass
    finally:
        if saved:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        out.write("\033[0m\033[?25h\033[?1049l")
        out.flush()


if __name__ == "__main__":
    main()
